<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>7f2c1a3e-9b4d-4c8a-8e2f-1a2b3c4d5e6f</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>RhetorIQ</ProviderName>
  <DefaultLocale>de-CH</DefaultLocale>
  <DisplayName DefaultValue="RhetorIQ" />
  <Description DefaultValue="E-Mails direkt in Ihrer Brand Voice generieren." />
  <IconUrl DefaultValue="https://rhetoriq.ch/addin/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://rhetoriq.ch/addin/icon-80.png" />
  <SupportUrl DefaultValue="https://rhetoriq.ch" />
  <AppDomains>
    <AppDomain>https://rhetoriq.ch</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.5" />
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://rhetoriq.ch/addin/taskpane.html" />
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit" />
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.5">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url" />
          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="RhetorIQ.Group1">
                <Label resid="Group1Label" />
                <Icon>
                  <bt:Image size="16" resid="icon-16" />
                  <bt:Image size="32" resid="icon-32" />
                  <bt:Image size="80" resid="icon-80" />
                </Icon>
                <Control xsi:type="Button" id="RhetorIQ.TaskpaneButton">
                  <Label resid="TaskpaneButton.Label" />
                  <Supertip>
                    <Title resid="TaskpaneButton.Label" />
                    <Description resid="TaskpaneButton.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon-16" />
                    <bt:Image size="32" resid="icon-32" />
                    <bt:Image size="80" resid="icon-80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="icon-16" DefaultValue="https://rhetoriq.ch/addin/icon-16.png" />
        <bt:Image id="icon-32" DefaultValue="https://rhetoriq.ch/addin/icon-32.png" />
        <bt:Image id="icon-80" DefaultValue="https://rhetoriq.ch/addin/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://rhetoriq.ch/addin/taskpane.html" />
        <bt:Url id="Taskpane.Url" DefaultValue="https://rhetoriq.ch/addin/taskpane.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Group1Label" DefaultValue="RhetorIQ" />
        <bt:String id="TaskpaneButton.Label" DefaultValue="Text generieren" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="E-Mail in Ihrer Brand Voice generieren" />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
